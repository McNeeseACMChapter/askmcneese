# Frontend environment template — copy to ".env" (Vite reads it automatically).
# Vite only exposes variables prefixed with VITE_ to the browser.

# Base URL of the FastAPI backend (must match the uvicorn --port).
# Default backend port is 8000. If 8000 is occupied locally, run uvicorn on 8001
# and set this to http://127.0.0.1:8001 instead.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_CLASS_DATA_MODE=staging
VITE_CLASS_TERM_ID=202660

# ACM Panel Vite app (askmcneese/acm/frontend). Ask owns :5173; ACM Panel owns :3100.
# Avoid 5174 — Windows Hyper-V often blocks that range. After /acm/login, browser goes here.
VITE_ACM_PANEL_URL=http://127.0.0.1:3100

# Google Forms feedback destination (no API key or backend proxy).
# Create a form with a multiple-choice Category field and paragraph Message field,
# link its Responses tab to a Google Sheet, then copy the formResponse URL and
# each field's entry.<number> name from a prefilled form URL.
VITE_GOOGLE_FEEDBACK_FORM_ACTION=https://docs.google.com/forms/d/e/REPLACE_FORM_ID/formResponse
VITE_GOOGLE_FEEDBACK_CATEGORY_ENTRY=entry.REPLACE_CATEGORY_ID
VITE_GOOGLE_FEEDBACK_MESSAGE_ENTRY=entry.REPLACE_MESSAGE_ID
