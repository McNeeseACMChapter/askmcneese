{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://askmcneese.local/schemas/campus-query.schema.json",
  "title": "CampusQuery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "original_query", "normalized_query", "domain", "subdomain", "intent",
    "action", "entities", "audience", "freshness", "risk", "answer_shape",
    "required_source_groups", "required_fields", "confidence", "ambiguities",
    "clarification_required"
  ],
  "properties": {
    "original_query": {"type": "string", "maxLength": 4000},
    "normalized_query": {"type": "string", "maxLength": 4000},
    "domain": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "subdomain": {"type": ["string", "null"]},
    "intent": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "action": {"type": ["string", "null"]},
    "entities": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
    },
    "audience": {"type": "string"},
    "freshness": {"enum": ["static", "term_based", "live", "personal"]},
    "risk": {"enum": ["low", "medium", "high"]},
    "answer_shape": {"type": "string"},
    "required_source_groups": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "ambiguities": {"type": "array", "items": {"type": "string"}},
    "clarification_required": {"type": "boolean"},
    "compiler_version": {"type": "string"},
    "decision_reasons": {"type": "array", "items": {"type": "string"}}
  }
}
