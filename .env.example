# AskMcNeese environment template
# Copy this file to ".env" and adjust values. NEVER commit a real ".env".

# ---------- Backend API (FastAPI) ----------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated origins the API accepts (the frontend dev server).
CORS_ALLOW_ORIGINS=http://localhost:5173

# ---------- Crawler / ingestion ----------
SOURCE_REGISTRY_PATH=knowledge/source_registry_seed.csv
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; AskMcNeeseBot/0.1; McNeese ACM student project)
REQUEST_TIMEOUT_SECONDS=20
# Allow crawling sources whose approval_status is still "Pending" (true for the Week 1 proof).
ALLOW_PENDING_SOURCES=true

# ---------- Chunking ----------
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=50

# ---------- ChromaDB (local vector store) ----------
CHROMA_DB_PATH=crawler/chroma_db
CHROMA_COLLECTION=askmcneese_sources

# ---------- Retrieval ----------
# Backend /ask reads the same ChromaDB store the crawler writes.
RETRIEVAL_TOP_K=3
# Query logging for analytics and debugging
QUERY_LOG_PATH=backend/logs/query_logs.jsonl

# ---------- LLM Answer Generation ----------
# Claude API key (get from https://console.anthropic.com/)
# NEVER commit your real key — keep it ONLY in your local .env
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE
# Model to use (claude-sonnet-4-20250514 recommended for speed/quality balance)
CLAUDE_MODEL=claude-sonnet-4-20250514
# Max tokens for answer generation
CLAUDE_MAX_TOKENS=1024

# ---------- RCCS (local/dev) ----------
# Production may keep RCCS_ENABLED=0; local web-mode proof requires 1.
RCCS_ENABLED=1
RCCS_HYBRID_ENABLED=1
RCCS_COMPANIONS_ENABLED=1
RCCS_RMP_ENABLED=1
RCCS_SOCIAL_LINKS_ENABLED=0

# ---------- Supervisor (Plan → Route → Execute → Reflect on top of RCCS) ----------
# Default off: keep proven hybrid_retrieve path. Set SUPERVISOR_ENABLED=1 to use
# the thin custom supervisor (no LangGraph/CrewAI). Requires RCCS_ENABLED=1.
SUPERVISOR_ENABLED=0
SUPERVISOR_REFLECT_ENABLED=1
# Optional Claude critique after heuristic reflection (adds latency/cost).
SUPERVISOR_REFLECT_LLM=0
# Product alias; when 1, treated as supervisor enabled for deep-research paths.
DEEP_RESEARCH_ENABLED=0

# ---------- Web browsing providers (local/dev) ----------
# Keep real keys only in backend/.env or repo .env — never commit them.
WEB_BROWSING_ENABLED=1
SEARCH_PROVIDER=auto
QUERY_REWRITE_ENABLED=1
QUERY_EXPANSION=llm
# Perplexity Sonar (agentic) + Embeddings
PERPLEXITY_EMBEDDINGS_ENABLED=1
PERPLEXITY_AGENTIC_ENABLED=1
PERPLEXITY_MODEL=sonar-pro
PERPLEXITY_AGENTIC_MODEL=sonar-pro
PERPLEXITY_EMBED_MODEL=pplx-embed-v1-0.6b
PERPLEXITY_SEARCH_TYPE=auto
PERPLEXITY_SEARCH_CONTEXT_SIZE=medium
# TAVILY_API_KEY=
# SERPER_API_KEY=          # google.serper.dev
# SERPAPI_API_KEY=         # serpapi.com (different product)
# PERPLEXITY_API_KEY=
# PERPLE_API_KEY=          # alias accepted if you used this name
