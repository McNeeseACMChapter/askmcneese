# AskMcNeese — environment template (PM-05)
# Copy this file to ".env" and adjust values. NEVER commit a real ".env".
# Sprint 1 has NO secrets — everything below is non-sensitive configuration.

# ---------- Backend API (FastAPI) ----------
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated origins the API accepts (the frontend dev server).
CORS_ALLOW_ORIGINS=http://localhost:5173

# ---------- Crawler / ingestion ----------
SOURCE_REGISTRY_PATH=knowledge/source_registry_seed.csv
CRAWLER_USER_AGENT=Mozilla/5.0 (compatible; AskMcNeeseBot/0.1; McNeese ACM student project)
REQUEST_TIMEOUT_SECONDS=20
# Allow crawling sources whose approval_status is still "Pending" (true for the Week 1 proof).
ALLOW_PENDING_SOURCES=true

# ---------- Chunking ----------
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=50

# ---------- ChromaDB (local vector store) ----------
CHROMA_DB_PATH=crawler/chroma_db
CHROMA_COLLECTION=askmcneese_sources

# ---------- Future (Sprint 2 — retrieval, NOT used until /ask is built) ----------
# Backend /ask reads the same ChromaDB store the crawler writes.
RETRIEVAL_TOP_K=3
# QUERY_LOG_PATH=backend/logs/query_logs.jsonl
# No LLM / answer generation yet. Add keys only when that work starts,
# and keep them ONLY in your local .env (never here, never committed).
# OPENAI_API_KEY=
