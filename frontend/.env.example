# Frontend environment template — copy to ".env" (Vite reads it automatically).
# Vite only exposes variables prefixed with VITE_ to the browser.

# Base URL of the FastAPI backend (must match the uvicorn --port).
# Default backend port is 8000. If 8000 is occupied locally, run uvicorn on 8001
# and set this to http://127.0.0.1:8001 instead.
VITE_API_BASE_URL=http://127.0.0.1:8000
