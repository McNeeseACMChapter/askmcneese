# Secrets are injected by the process/container and always override this file.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=
PERPLEXITY_API_KEY=

# Public API boundary
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Anonymous browser identity, beta allowance, and feedback review
ONBOARDING_MODE=mandatory
GUEST_DB_PATH=guest_sessions.sqlite3
GUEST_COOKIE_MAX_AGE_SECONDS=5184000
GUEST_COOKIE_SECURE=false
GUEST_QUESTION_LIMIT=10
FEEDBACK_ADMIN_TOKEN=change-me-locally
ONBOARDING_DEV_RESET=true
ASK_MAX_BODY_BYTES=98304
ASK_RATE_LIMIT_PER_MINUTE=24
ASK_MAX_CONCURRENT_REQUESTS=8
ASK_CONCURRENCY_WAIT_MS=250

# Fast evidence-first retrieval
RCCS_ENABLED=1
RCCS_HYBRID_ENABLED=1
RCCS_TOTAL_RETRIEVAL_TIMEOUT_SECONDS=10
RCCS_FAST_RETRIEVAL_TIMEOUT_SECONDS=3.5
RCCS_CATALOG_RETRIEVAL_TIMEOUT_SECONDS=40
RCCS_MAX_KB_RESULTS=6
RCCS_MAX_OFFICIAL_RESULTS=4
RCCS_MAX_COMPANION_RESULTS=3
RCCS_MAX_TOTAL_EVIDENCE=8
RCCS_MAX_CITATIONS=4
RCCS_MIN_RELEVANCE_SCORE=0.22

# Paid enrichment is fallback-only
QUERY_REWRITE_ENABLED=0
PERPLEXITY_EMBEDDINGS_ENABLED=0
PERPLEXITY_AGENTIC_ENABLED=1
WEB_BROWSING_ENABLED=1
WEB_MAX_PAGE_BYTES=2097152

# Privacy-safe observability
TEST_CASE_RECORDING_ENABLED=0
ASKMCNEESE_LOG_QUESTION_TEXT=0
ASKMCNEESE_DEBUG_TRACE=0

# Bound fetched evidence before relevance-aware LLM excerpting.
RCCS_MAX_CHARS_PER_SOURCE=8000

# Current official catalog index used for complete degree-plan retrieval.
# Update these together when McNeese publishes a new catalog year.
MCNEESE_CATALOG_ID=102
MCNEESE_CATALOG_YEAR=2026-2027
MCNEESE_CATALOG_PROGRAMS_NAV_ID=8461
